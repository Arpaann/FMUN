# ==============================================================================
# FMUN 2026 (Fluorescent Model United Nations) - Environment Variables Template
# Copy this file to .env.local and configure your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Credentials
# ------------------------------------------------------------------------------
# Find in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Server-only service role key (NEVER expose to the browser bundle)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. eSewa EPAY v2 Integration Credentials
# Docs: https://developer.esewa.com.np/
# ------------------------------------------------------------------------------
# Set to 'sandbox' for testing or 'production' for live transactions
ESEWA_ENVIRONMENT=sandbox
# Default UAT test merchant code is 'EPAYTEST'
ESEWA_MERCHANT_CODE=EPAYTEST
# Default UAT test secret key is '8gBm/:&EnhH.1/q'
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# Set to 'true' to trigger remote server-to-server status check during verification
ESEWA_VERIFY_REMOTE=false

# ------------------------------------------------------------------------------
# 3. Khalti ePayment v2 Gateway Credentials
# Docs: https://docs.khalti.com/
# ------------------------------------------------------------------------------
# Set to 'sandbox' or 'production'
KHALTI_ENVIRONMENT=sandbox
# Khalti live secret key (starts with 'live_secret_key_...' or sandbox key)
KHALTI_SECRET_KEY=test_secret_key_placeholder

# ------------------------------------------------------------------------------
# 4. Email Delivery Provider (Optional / Configurable)
# ------------------------------------------------------------------------------
EMAIL_FROM="FMUN Secretariat <fmun2026@fluorescent.edu.np>"
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-smtp-api-key

# ------------------------------------------------------------------------------
# 5. Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
